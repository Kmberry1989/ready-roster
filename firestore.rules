rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOrgAdmin(appId, orgId) {
      return signedIn()
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/organizations/$(orgId)).data.adminUid == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/users/{userId} {
      allow get, create, update: if signedIn() && request.auth.uid == userId;
    }

    match /artifacts/{appId}/public/data/organizations/{orgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.adminUid == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/{collectionName}/{documentId} {
      allow read: if signedIn() && collectionName in ['events', 'documentTemplates'];
      allow create: if signedIn()
        && collectionName in ['events', 'documentTemplates']
        && isOrgAdmin(appId, request.resource.data.orgId);
      allow update: if signedIn()
        && collectionName in ['events', 'documentTemplates']
        && isOrgAdmin(appId, resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn()
        && collectionName in ['events', 'documentTemplates']
        && isOrgAdmin(appId, resource.data.orgId);
    }

    match /artifacts/{appId}/public/data/volunteers/{volunteerId} {
      allow create: if signedIn() && request.resource.data.volunteerUid == request.auth.uid;
      allow get, list: if signedIn()
        && (resource.data.volunteerUid == request.auth.uid || isOrgAdmin(appId, resource.data.orgId));
    }
  }
}
